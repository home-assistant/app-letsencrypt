{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["dockerfile", "github-actions", "custom.regex"],
  "semanticCommits": "disabled",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "acme in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": ["\\sACME_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "acme",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "certbot-dns-azure in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": ["\\sCERTBOT_DNS_AZURE_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "certbot-dns-azure",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "certbot-dns-eurodns in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": ["\\sCERTBOT_DNS_EURODNS_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "certbot-dns-eurodns",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "certbot-dns-hurricane-electric in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": [
        "\\sCERTBOT_DNS_HURRICANE_ELECTRIC_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "certbot-dns-hurricane-electric",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "certbot-dns-multi in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": ["\\sCERTBOT_DNS_MULTI_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "certbot-dns-multi",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "certbot-dns-norisnetwork in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": [
        "\\sCERTBOT_DNS_NORISNETWORK_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "certbot-dns-norisnetwork",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "certbot in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": ["\\sCERTBOT_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "certbot",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "cryptography in the Dockerfile",
      "managerFilePatterns": ["/^letsencrypt/Dockerfile$/"],
      "matchStrings": ["\\sCRYPTOGRAPHY_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "cryptography",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/base-debian"],
      "versionCompatibility": "^trixie-(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioning": "pep440",
      "sourceUrl": "https://github.com/home-assistant/docker-base",
      "groupName": "docker-base",
      "commitMessageTopic": "home-assistant/base-debian image",
      "commitMessageExtra": "to {{newValue}}"
    },
    {
      "description": "Dockerfile ARGs pin image components, so title their PRs \"Update <name> to <version>\"",
      "matchManagers": ["custom.regex"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "certbot and acme are released together, certbot-dns-gehirn follows the certbot version",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["acme", "certbot"],
      "groupName": "certbot"
    },
    {
      "description": "GitHub Actions: weekly with a 7 day cooldown, like Dependabot did",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["before 8am on monday"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Leave runner labels and action version inputs alone, Dependabot never updated those",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Our own actions that follow a branch (like home-assistant/actions@master) float on purpose. Pinning them would open a digest PR in every repository for each change to them. Our own actions on a version tag are pinned like any other.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/**"],
      "matchCurrentValue": "/^(dev|main|master)$/",
      "pinDigests": false
    }
  ]
}
